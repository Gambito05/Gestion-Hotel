@host = http://localhost:9090/api
@uri = {{host}}/reservas-habitacion
@token = PEGAR_AQUI_EL_TOKEN_DEL_LOGIN

### Listar todos
GET {{uri}}
Authorization: Bearer {{token}}

### Obtener por id
GET {{uri}}/1
Authorization: Bearer {{token}}

### Registro que no existe (404)
GET {{uri}}/9999
Authorization: Bearer {{token}}

### Filtrar primera página de 10
GET {{uri}}/filter/0/10?codigo=&estado=&cliente_id=3
Authorization: Bearer {{token}}

### Filtrar segunda página de 5
GET {{uri}}/filter/5/5?codigo=&estado=&cliente_id=3
Authorization: Bearer {{token}}

### Filtrar con límite mayor a 100 (422)
GET {{uri}}/filter/0/500?codigo=&estado=&cliente_id=3
Authorization: Bearer {{token}}

### Filtrar con offset negativo (422)
GET {{uri}}/filter/-1/10?codigo=&estado=&cliente_id=3
Authorization: Bearer {{token}}

### Insertar con JSON inválido (400)
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}



### Insertar reserva válida
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "RH-0004",
    "cliente_id": 4,
    "habitacion_id": 4,
    "fecha_entrada": "2027-02-10",
    "fecha_salida": "2027-02-12",
    "huespedes": 3,
    "precio_noche": 60000,
    "total": 120000
}

### Insertar con código sin formato RH- (400)
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "0004",
    "cliente_id": 4,
    "habitacion_id": 4,
    "fecha_entrada": "2027-02-10",
    "fecha_salida": "2027-02-12",
    "huespedes": 3,
    "precio_noche": 60000,
    "total": 120000
}

### Insertar con fecha que no existe (400)
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "RH-0005",
    "cliente_id": 4,
    "habitacion_id": 4,
    "fecha_entrada": "2027-02-30",
    "fecha_salida": "2027-03-02",
    "huespedes": 3,
    "precio_noche": 60000,
    "total": 120000
}

### Insertar con fecha en otro formato (400)
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "RH-0005",
    "cliente_id": 4,
    "habitacion_id": 4,
    "fecha_entrada": "10-02-2027",
    "fecha_salida": "12-02-2027",
    "huespedes": 3,
    "precio_noche": 60000,
    "total": 120000
}

### Insertar con huéspedes 0 (400)
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "RH-0005",
    "cliente_id": 4,
    "habitacion_id": 4,
    "fecha_entrada": "2027-02-10",
    "fecha_salida": "2027-02-12",
    "huespedes": 0,
    "precio_noche": 60000,
    "total": 120000
}

### Insertar con check-in sin hora (400)
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "RH-0005",
    "cliente_id": 4,
    "habitacion_id": 4,
    "fecha_entrada": "2027-02-10",
    "fecha_salida": "2027-02-12",
    "huespedes": 3,
    "precio_noche": 60000,
    "total": 120000,
    "checkin_at": "2027-02-10"
}

### Insertar con salida antes de la entrada (422 desde datos)
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "RH-0005",
    "cliente_id": 4,
    "habitacion_id": 4,
    "fecha_entrada": "2027-02-12",
    "fecha_salida": "2027-02-10",
    "huespedes": 3,
    "precio_noche": 60000,
    "total": 120000
}

### Hacer check-out de Laura
PUT {{uri}}/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "estado": "FINALIZADA",
    "checkout_at": "2026-12-23 11:00:00"
}

### ===== Reglas de negocio =====
### Reserva sin precio ni total: la capa de negocio los calcula (noches x precio del tipo)
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "RH-0100",
    "cliente_id": 3,
    "habitacion_id": 1,
    "fecha_entrada": "2026-12-20",
    "fecha_salida": "2026-12-23",
    "huespedes": 2
}

### Misma habitación con fechas que se cruzan con la anterior (409)
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "RH-0101",
    "cliente_id": 3,
    "habitacion_id": 1,
    "fecha_entrada": "2026-12-22",
    "fecha_salida": "2026-12-24",
    "huespedes": 1
}

### Más huéspedes que la capacidad del tipo de habitación (400)
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "RH-0102",
    "cliente_id": 3,
    "habitacion_id": 1,
    "fecha_entrada": "2027-01-10",
    "fecha_salida": "2027-01-12",
    "huespedes": 20
}

### Fecha de salida igual a la de entrada (400)
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "RH-0103",
    "cliente_id": 3,
    "habitacion_id": 1,
    "fecha_entrada": "2027-01-10",
    "fecha_salida": "2027-01-10",
    "huespedes": 1
}

### Actualizar con un estado que no existe (400, validación parcial)
PUT {{uri}}/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "estado": "XYZ"
}

### Buscar reservas que se cruzan con un rango de fechas
GET {{uri}}/filter/0/10?habitacion_id=1&entrada_antes_de=2026-12-31&salida_despues_de=2026-12-01
Authorization: Bearer {{token}}

### Con token de cliente: listar todas (403)
GET {{uri}}
Authorization: Bearer {{token}}

### Con token de cliente: el filtro solo devuelve sus reservas aunque pida otro cliente_id
GET {{uri}}/filter/0/10?cliente_id=1
Authorization: Bearer {{token}}

###
