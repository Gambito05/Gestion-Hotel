@host = http://localhost:9090/api
@uri = {{host}}/roles
@token = PEGAR_AQUI_EL_TOKEN_DEL_LOGIN

### Listar todos
GET {{uri}}
Authorization: Bearer {{token}}

### Obtener por id
GET {{uri}}/1
Authorization: Bearer {{token}}

### Registro que no existe (404)
GET {{uri}}/9999
Authorization: Bearer {{token}}

### Filtrar primera página de 10
GET {{uri}}/filter/0/10?nombre=
Authorization: Bearer {{token}}

### Filtrar segunda página de 5
GET {{uri}}/filter/5/5?nombre=
Authorization: Bearer {{token}}

### Filtrar con límite mayor a 100 (422)
GET {{uri}}/filter/0/500?nombre=
Authorization: Bearer {{token}}

### Filtrar con offset negativo (422)
GET {{uri}}/filter/-1/10?nombre=
Authorization: Bearer {{token}}

### Insertar con JSON inválido (400)
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}



### Insertar rol válido
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "nombre": "GERENTE"
}

### Insertar rol en minúsculas (400)
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "nombre": "gerente"
}

### Insertar rol con menos de 3 caracteres (400)
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "nombre": "AB"
}

### Insertar sin nombre (400)
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{}

### Insertar rol repetido (409 desde datos)
POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "nombre": "ADMIN"
}

### Eliminar rol que no existe (404)
DELETE {{uri}}/9999
Authorization: Bearer {{token}}

###
