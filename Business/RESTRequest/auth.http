@host = http://localhost:9090/api

### Login del administrador
POST {{host}}/auth/login
Content-Type: application/json

{
    "email": "bryan@hotel.com",
    "password": "Bryan13$"
}

### Login del administrador usando username
POST {{host}}/auth/login
Content-Type: application/json

{
    "username": "adminbryan",
    "password": "Bryan13$"
}

### Login de la recepcionista
POST {{host}}/auth/login
Content-Type: application/json

{
    "email": "recepcion@hotel.com",
    "password": "Clave123*"
}

### Login con contraseña incorrecta (401)
POST {{host}}/auth/login
Content-Type: application/json

{
    "email": "admin@hotel.com",
    "password": "OtraClave1*"
}

### Login con email que no existe (401)
POST {{host}}/auth/login
Content-Type: application/json

{
    "email": "nadie@hotel.com",
    "password": "Clave123*"
}

### Login sin datos (422)
POST {{host}}/auth/login
Content-Type: application/json

{
    "email": "",
    "password": ""
}

### Consultar sin token (401)
GET {{host}}/roles
